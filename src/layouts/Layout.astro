---
const { title = "Posts" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a href="/">Posts</a>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fbfbf9;
    --text: #1d2327;
    --muted: #646970;
    --line: #dcdcd6;
    --link: #1a56a0;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #16181a;
      --text: #e6e6e3;
      --muted: #9aa0a6;
      --line: #2e3236;
      --link: #7fb0ee;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 18px/1.65 Georgia, "Times New Roman", serif;
  }
  a { color: var(--link); }
  a:focus-visible { outline: 2px solid var(--link); outline-offset: 3px; }
  .site-header, main { max-width: 42rem; margin: 0 auto; padding: 1.25rem 1.25rem; }
  .site-header { border-bottom: 1px solid var(--line); font-weight: bold; }
  .site-header a { color: inherit; text-decoration: none; }
  img { max-width: 100%; height: auto; }
</style>
