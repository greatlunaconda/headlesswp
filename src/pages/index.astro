---
import Layout from "../layouts/Layout.astro";
import { getAllPosts, postMeta } from "../lib/wp.js";

const posts = await getAllPosts();
---
<Layout title="Posts">
  <h1>Latest posts</h1>

  {posts.length === 0 && <p>No posts have been published yet.</p>}

  <ul class="posts">
    {posts.map((post) => {
      const { image, imageAlt, author, date } = postMeta(post);
      return (
        <li>
          {image && <img src={image} alt={imageAlt} loading="lazy" />}
          <h2><a href={`/posts/${post.slug}`} set:html={post.title.rendered} /></h2>
          <p class="meta">{date}{author && `, by ${author}`}</p>
          <div class="excerpt" set:html={post.excerpt.rendered} />
        </li>
      );
    })}
  </ul>
</Layout>

<style>
  h1 { font-size: 2rem; margin: 1rem 0 2rem; }
  .posts { list-style: none; margin: 0; padding: 0; }
  .posts li { padding: 1.75rem 0; border-top: 1px solid var(--line); }
  .posts h2 { font-size: 1.5rem; line-height: 1.25; margin: 0.75rem 0 0.25rem; }
  .meta { color: var(--muted); font-size: 0.9rem; margin: 0 0 0.5rem; }
  .excerpt :global(p) { margin: 0; }
</style>
